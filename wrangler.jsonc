{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loneitu",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "LONEITU_KV",
      "id": "ae8aa0eaf70f499a85e7f4b5fb523f92"
    }
  ],
  "build": {
    "command": "npm run build"
  }
}

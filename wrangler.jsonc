{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loneitu",
  "compatibility_date": "2026-03-01",
  "pages_build_output_dir": "dist",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "npm run build"
  }
}
